{
  "version": 2,
  "cleanUrls": true,
  "outputDirectory": "public",
  "functions": {
    "api/*.js": {
      "includeFiles": "apps/**,packages/**,public/**",
      "maxDuration": 15
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/checkout/(.*)", "destination": "/api" },
    { "source": "/admin(.*)", "destination": "/api" },
    { "source": "/health", "destination": "/api" }
  ]
}

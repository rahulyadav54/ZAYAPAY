{
  "version": 2,
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "includeFiles": "apps/**,packages/**",
      "maxDuration": 15
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/checkout/(.*)", "destination": "/api/index.js" },
    { "source": "/admin(.*)", "destination": "/api/index.js" },
    { "source": "/health", "destination": "/api/index.js" }
  ]
}
